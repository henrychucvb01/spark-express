# Server only. Never prefix credentials with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXPRESS_RATE_LIMIT_SECRET=
EXPRESS_ORIGIN=http://localhost:5173
# Keep false until the isolated database and roster import are verified.
EXPRESS_ACCOUNTS_ENABLED=false
# Set only in the production Vercel environment, never Preview.
EXPRESS_ALLOW_PRODUCTION_DATABASE=false
# Optional verified-email recovery. Configure a verified sender before enabling.
RESEND_API_KEY=
EXPRESS_EMAIL_FROM=
